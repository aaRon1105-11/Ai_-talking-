{
  "manifest_version": 3,
  "name": "Gemini Auto-Listen",
  "version": "1.2.0",
  "description": "Automatically triggers the built-in Listen (TTS) feature on gemini.google.com when a response finishes generating.",

  "permissions": ["storage"],

  "host_permissions": ["*://gemini.google.com/*"],

  "content_scripts": [
    {
      "matches": ["*://gemini.google.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],

  "action": {
    "default_popup": "popup.html",
    "default_title": "Gemini Auto-Listen Settings"
  }
}
